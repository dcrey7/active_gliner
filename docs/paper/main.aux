\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces LoRA layer configuration comparison. Each bar shows the F\textsubscript  {1}{} achieved with different groups of target modules. The number of modules is annotated inside each bar. Configurations including ModernBERT layers (yellow) consistently outperform those without (green). The best configuration (ModernBERT + Task) uses only 12 modules.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:lora_layers}{{3}{5}{LoRA layer configuration comparison. Each bar shows the \fone {} achieved with different groups of target modules. The number of modules is annotated inside each bar. Configurations including ModernBERT layers (yellow) consistently outperform those without (green). The best configuration (ModernBERT + Task) uses only 12 modules}{figure.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Test set F\textsubscript  {1}{} by acquisition function and training size. N = number of labeled sentences. LC = Least Confidence (minimum span score). Best per row in \textbf  {bold}, highlighted in \colorbox {lightgreen}{green}. LC reaches 80 F\textsubscript  {1}{} with only 200 examples and consistently leads at small to medium budgets.}}{5}{table.caption.5}\protected@file@percent }
\newlabel{tab:active_learning}{{2}{5}{Test set \fone {} by acquisition function and training size. N = number of labeled sentences. LC = Least Confidence (minimum span score). Best per row in \textbf {bold}, highlighted in \colorbox {lightgreen}{green}. LC reaches 80 \fone {} with only 200 examples and consistently leads at small to medium budgets}{table.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}GLiNER vs. LLM on Hard Examples}{5}{subsection.5.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Active learning strategy comparison on MIT Movies. Each line shows test set F\textsubscript  {1}{} as a function of the number of training examples selected by that strategy. All strategies are fine-tuned on ground truth labels with LoRA. The largest gains occur between 50 and 400 labeled sentences. Beyond 1{,}500 examples, strategies converge, with Least Confidence (orange) ending slightly ahead.}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:active_learning}{{4}{6}{Active learning strategy comparison on MIT Movies. Each line shows test set \fone {} as a function of the number of training examples selected by that strategy. All strategies are fine-tuned on ground truth labels with LoRA. The largest gains occur between 50 and 400 labeled sentences. Beyond 1{,}500 examples, strategies converge, with Least Confidence (orange) ending slightly ahead}{figure.caption.6}{}}
