\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Zero-shot comparison between GLiNER Base and Gemma 3 12B on the worst confidence training examples (ranked by MSE). The LLM maintains a consistent advantage on examples where GLiNER is most uncertain, motivating the use of LLM labels as supplementary supervision for these difficult cases.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:baseline_confidence}{{5}{7}{Zero-shot comparison between GLiNER Base and Gemma 3 12B on the worst confidence training examples (ranked by MSE). The LLM maintains a consistent advantage on examples where GLiNER is most uncertain, motivating the use of LLM labels as supplementary supervision for these difficult cases}{figure.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Estimated annual cost for 1M NER tasks. LLM costs assume 1{,}000 input + 1{,}000 output tokens per task at published API prices. GLiNER cost = two retraining cycles per year on cloud GPU (${\sim }$2 EUR each) with zero inference cost.}}{7}{table.caption.11}\protected@file@percent }
\newlabel{tab:cost}{{4}{7}{Estimated annual cost for 1M NER tasks. LLM costs assume 1{,}000 input + 1{,}000 output tokens per task at published API prices. GLiNER cost = two retraining cycles per year on cloud GPU (${\sim }$2 EUR each) with zero inference cost}{table.caption.11}{}}
