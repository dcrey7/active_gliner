\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Test set F\textsubscript  {1}{} at different mixing ratios (minimum confidence ranking). Column headers show percentage of sentences with human labels; the rest use Gemma 3 12B labels. \colorbox {lightgreen}{Green} = near or at best performance. \colorbox {lightred!40}{Red} = pure synthetic labels. At 75\% GT, performance matches full supervision within 1 F\textsubscript  {1}{} point.}}{6}{table.caption.10}\protected@file@percent }
\newlabel{tab:mixing}{{3}{6}{Test set \fone {} at different mixing ratios (minimum confidence ranking). Column headers show percentage of sentences with human labels; the rest use Gemma 3 12B labels. \colorbox {lightgreen}{Green} = near or at best performance. \colorbox {lightred!40}{Red} = pure synthetic labels. At 75\% GT, performance matches full supervision within 1 \fone {} point}{table.caption.10}{}}
